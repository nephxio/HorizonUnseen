# Build directories
build/
build-*/
out/
cmake-build-*/

# Runtime output
logs/
saves/

# Packaged releases (produced by tools/package_release.py)
dist/

# Python
__pycache__/
*.pyc

# Reinforcement learning training output.
#
# Checkpoints are ~1.3 MB of binary per run and regenerate from training, so
# committing them would grow history by that much every experiment with no way
# for git to compress it. Keep a specific agent by copying it out of runs/
# deliberately rather than by tracking the whole directory.
tools/rl/runs/

# Visual Studio
.vs/
*.user
*.suo
*.vcxproj.user

# Compiled Object files
*.o
*.obj

# Executables
*.exe
*.out
*.app

# Dependencies
#
# glfw and imgui are git submodules pinned to specific commits, so they are
# tracked rather than ignored. Pinning matters: glfw was previously an
# unpinned clone of master, which meant two checkouts could silently build
# against different versions of it.

# Compiled shaders
*.spv

# IDE
.vscode/
.idea/

# Game data files
*.dat
game.dat
